# OMNIA Scriptor Environment Variables Example
PORT=3000
NODE_ENV=development

# Server-Side Gemini API Key (Secret - NEVER prefix with VITE_)
GEMINI_API_KEY=

# Optional OpenCode Provider API Key
OPENCODE_API_KEY=

# Comma/space-separated origins allowed to iframe the app (CSP frame-ancestors).
# Defaults to AI Studio. Set to your own domain when self-hosting.
FRAME_ANCESTORS=

# Extra origins the browser may connect to (CSP connect-src), space-separated.
EXTRA_CONNECT_SRC=

# Optional shared secret protecting /api. Unset = no authentication (default).
# Set this before exposing the server publicly: every endpoint spends the
# server's AI credits. Callers send it as "Authorization: Bearer <token>".
API_ACCESS_TOKEN=
